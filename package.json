{
  "name": "llm-agent",
  "version": "0.1.0",
  "description": "Agent loop with filesystem, web search and web fetch tools for local LLMs, OpenAI and Anthropic, with a terminal CLI and a browser UI",
  "license": "MIT",
  "private": true,
  "type": "module",
  "keywords": [
    "llm",
    "agent",
    "ai-agent",
    "tool-calling",
    "llama.cpp",
    "openai",
    "anthropic",
    "searxng"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "ui": "node src/server.ts",
    "playground": "node src/server.ts -w playground",
    "doctor": "node scripts/doctor.ts",
    "check": "biome ci && tsc -p . && node --test test/*.test.ts",
    "lint": "biome lint",
    "format": "biome format --write",
    "fix": "biome check --write",
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.ts",
    "search:up": "docker compose up -d searxng",
    "search:down": "docker compose stop searxng",
    "search:logs": "docker compose logs -f searxng",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f agent"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "linkedom": "^0.18.14",
    "marked": "^18.1.2",
    "mermaid": "^12.2.0",
    "openai": "^7.45.0",
    "turndown": "^7.2.4",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  }
}
