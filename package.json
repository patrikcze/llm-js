{
  "name": "llm-agent",
  "version": "0.1.0",
  "description": "Agent loop with filesystem, web search and web fetch tools for local LLMs, OpenAI and Anthropic, with a terminal CLI and a browser UI",
  "license": "MIT",
  "private": true,
  "type": "module",
  "keywords": [
    "llm",
    "agent",
    "ai-agent",
    "tool-calling",
    "llama.cpp",
    "openai",
    "anthropic",
    "searxng"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.ts",
    "ui": "node src/server.ts",
    "playground": "node src/server.ts -w playground",
    "search:up": "docker compose up -d searxng",
    "search:down": "docker compose stop searxng",
    "search:logs": "docker compose logs -f searxng",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f agent"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.17",
    "linkedom": "^0.18.14",
    "marked": "^18.1.1",
    "openai": "^7.43.0",
    "turndown": "^7.2.4",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  }
}
