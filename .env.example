# Copy to .env (git-ignored). src/config.ts loads it on start; variables set in your shell take precedence.

# Local SearXNG from docker-compose.yml (`npm run search:up`)
SEARXNG_URL=http://127.0.0.1:8888

# Alternatives (first one set wins: Tavily, Brave, SearXNG, then DuckDuckGo)
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# LLM server
# LLM_BASE_URL=http://localhost:9931/v1
# LLM_MODEL=ggml-org/gemma-4-26B-A4B-it-GGUF:Q4_0
# LLM_API_KEY=no-key
